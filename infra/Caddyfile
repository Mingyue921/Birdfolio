{
  email {$ACME_EMAIL}
}

{$DEMO_HOST} {
  encode zstd gzip
  handle /api/* {
    reverse_proxy api:8787
  }
  handle /health/* {
    reverse_proxy api:8787
  }
  handle {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}
