NODE_ENV=production
HOST=0.0.0.0
PORT=8787
HTTPS_PROXY=true
CORS_ORIGIN=https://api.birdfolio.example
REQUIRE_AUTH=true
DEMO_MODE=false
DEPLOYMENT_PROFILE=commercial
COMPETITION_DEMO_LOGIN=false
CACHE_PROVIDER=redis
REDIS_URL=
REDIS_KEY_PREFIX=birdfolio
VISION_PROVIDER=huawei_maas
AUTH_DEBUG_CODES=false

DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://birdfolio:replace-me@postgres.example:5432/birdfolio
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

MEDIA_STORAGE=obs
OBS_ENDPOINT=https://obs.cn-east-3.myhuaweicloud.com
OBS_BUCKET=
OBS_ACCESS_KEY_ID=
OBS_SECRET_ACCESS_KEY=

MAIL_PROVIDER_URL=https://mail-provider.example/send
MAIL_PROVIDER_TOKEN=

VISION_API_URL=https://vision-provider.example/v1/chat/completions
VISION_API_KEY=
VISION_MODEL=
