# Use development locally; set production only with the full Release checklist.
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
# In a deployed environment use an HTTPS reverse proxy and an explicit allow-list.
# The current local server does not terminate TLS itself.
# CORS_ORIGIN=https://your-app.example.com
# REQUIRE_AUTH=false for local compatibility; set true before any public deployment.
REQUIRE_AUTH=false
# Keep seed posts only for local demonstrations; set false for a real Beta database.
DEMO_MODE=true
# Generic HTTPS mail gateway used by the server to deliver one-time codes.
# Leave empty only for local development with AUTH_DEBUG_CODES=true.
# MAIL_PROVIDER_URL=https://mail-gateway.example.com/send
# MAIL_PROVIDER_TOKEN=
# AI_DAILY_LIMIT=10
# AUTH_DEBUG_CODES=false
# AUTH_DEV_CODE= (仅本地测试使用；生产环境不要设置)
# Use the full Chat Completions URL of a vision-capable OpenAI-compatible provider.
# All three settings must be nonempty; restart the server after editing.
# Never paste the Key into the app, source code, or a chat message.
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=
